#!/bin/sh
# Load USB ethernet (CDC-NCM) modules for the UGREEN 20256 / ASIX AX88179B dongle.
# Runs after S12udev, so the udev rule (70-usb-ethernet.rules) is in place to
# rename usb0 -> eth0 as soon as the device appears. This script only loads.
MODDIR=/usr/data/k1se-eth

case "$1" in
  start)
	printf "Loading USB ethernet modules: "
	# /usr/data is mounted by S02mount_mmc_ext4; wait for it if an fsck delayed it
	i=0
	while [ ! -f $MODDIR/mii.ko ] && [ $i -lt 100 ]; do i=$((i+1)); sleep 0.1; done
	[ -f $MODDIR/mii.ko ] || { echo "FAIL ($MODDIR not available)"; exit 1; }
	for m in mii usbnet cdc_ncm; do
		grep -q "^$m " /proc/modules || insmod $MODDIR/$m.ko || { echo "FAIL ($m)"; exit 1; }
	done
	# Naming is 70-usb-ethernet.rules' job and bringing the link up is ifplugd's,
	# so there is nothing to wait for here: whenever the device appears - now, or
	# when someone plugs it in later - udev renames usb0 to eth0. This script
	# reports what it can see at this instant and gets out of the way.
	if [ -d /sys/class/net/eth0 ]; then echo "OK (eth0 present)"
	elif [ -d /sys/class/net/usb0 ]; then echo "OK (modules loaded; udev names it eth0 - if it stays usb0, see install.sh status)"
	else echo "OK (modules loaded; no dongle detected yet)"
	fi
	;;
  stop)
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
exit 0
